{
  // OAuth-gated variant of the worker, for Claude.ai web custom connectors.
  // Deploy with:  npx wrangler deploy -c wrangler.oauth.jsonc
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "signrequest-mcp-oauth",
  "main": "src/oauth.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "durable_objects": {
    "bindings": [
      { "name": "MCP_OBJECT", "class_name": "SignRequestMCP" },
      // The worker's own generated seal key for /managed. Never delete or rename it or its migration.
      { "name": "EMA_KEYS", "class_name": "EmaKeyStore" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SignRequestMCP"] },
    { "tag": "v2", "new_sqlite_classes": ["EmaKeyStore"] }
  ],
  "kv_namespaces": [
    { "binding": "OAUTH_KV", "id": "78bea39d621541e997a7c8e3e360c9f4" }
  ],
  // Team context: API calls go to https://voltasolar.signrequest.com/api/v1 (a SignRequest
  // login spans every team the user belongs to; this pins the connector to one).
  "vars": { "SIGNREQUEST_TEAM": "voltasolar" },
  "alias": { "ai": "./src/ai-stub.ts" },
  "observability": { "enabled": true }
}
